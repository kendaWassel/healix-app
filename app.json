{
  "expo": {
    "name": "Healix",
    "slug": "medical-app",
    "version": "1.0.0",
    "scheme": "healix",
    "orientation": "portrait",
    "icon": "./assets/Logo-dark.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyDVsG_l8IRcPhEoZFZOcrDbyLWdZ7HOpCo"
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#052443"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDVsG_l8IRcPhEoZFZOcrDbyLWdZ7HOpCo"
        }
      },
      "edgeToEdgeEnabled": true,
      "queries": [
        {
          "intent": {
            "action": "android.intent.action.DIAL",
            "data": {
              "scheme": "tel"
            }
          }
        }
      ],
      "package": "com.anonymous.medicalapp",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-localization",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location so we can share it with the patient during delivery."
        }
      ],
      "./withDisableForceDark.js",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "36d3082b-6d5b-44ea-ada0-fc60d255ccbb"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/36d3082b-6d5b-44ea-ada0-fc60d255ccbb"
    }
  }
}
